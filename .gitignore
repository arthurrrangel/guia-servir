.vercel
.env*

# artefatos de build e dependências. Estavam fora do .gitignore e apareciam
# como não rastreados em todo `git status` — um dia alguém commita 40 mil
# arquivos de node_modules por engano. Nenhum deles pertence ao repositório.
node_modules
.next
.next-*
tsconfig.tsbuildinfo

# capturas dos scripts de auditoria (scripts/auditoria-estados.mjs escreve
# no diretório de trabalho). São prova de um run, não código.
est-*.png
s-*.png

# 19/09/2026: saida de build de sessoes anteriores (167 MB). Nao e fonte.
tmp/

# 21/09/2026: bytecode do Python. O `scripts/sabotar-migracao.py` importa
# `scripts/sabotagens/NN.py`, e o import deixa .pyc. Nao e fonte, e entrou
# no repositorio por descuido.
__pycache__/
*.pyc
